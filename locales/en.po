# Error Explanations (Educational Diagnostic Engine)
msgid "diag_borrow_checker_code"
msgstr "E0502 / E0596"

msgid "diag_borrow_checker_explanation"
msgstr "You attempted to modify or borrow a variable as mutable while there is an active immutable (&) reference, or the variable itself was not declared with `let mut`."

msgid "diag_borrow_checker_hint"
msgstr "Check: 1) Is the variable declared with `let mut`? 2) Has the prior immutable reference finished its scope before using mutable borrow?"

msgid "diag_segfault_code"
msgstr "SIGSEGV (139)"

msgid "diag_segfault_explanation"
msgstr "A runtime memory access violation occurred: the process attempted to read or write memory it does not have permission to access (e.g. NULL pointer, array out-of-bounds)."

msgid "diag_segfault_hint"
msgstr "Common causes: 1) Did you verify pointer is not NULL? 2) Does the array index stay strictly within [0, N-1]? 3) Are you writing to uninitialized pointers?"

msgid "diag_undefined_ref_code"
msgstr "Linker Error"

msgid "diag_undefined_ref_explanation"
msgstr "The compiler found the function declaration in the header (.h), but the linker cannot find the actual function implementation (body) among compiled object files."

msgid "diag_undefined_ref_hint"
msgstr "Check: Did you provide all .c / .cpp source files during compilation? (e.g. `gcc main.c utils.c -o program`)"

msgid "diag_index_error_code"
msgstr "IndexError"

msgid "diag_index_error_explanation"
msgstr "You requested an index from a list/array that does not exist (index is too large or list is empty)."

msgid "diag_index_error_hint"
msgstr "Check list length: `len(items)`. Remember: a 5-element list has indices 0, 1, 2, 3, 4."

