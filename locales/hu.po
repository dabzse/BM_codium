# Hibamagyarázatok (Oktatói diagnosztikai motor)
msgid "diag_borrow_checker_code"
msgstr "E0502 / E0596"

msgid "diag_borrow_checker_explanation"
msgstr "A változót megpróbáltad módosítani vagy mutábilisan kölcsönözni, miközben már van rá élő olvasási (&) referencia, vagy maga a változó nincs `mut`-ként deklarálva."

msgid "diag_borrow_checker_hint"
msgstr "Ellenőrizd: 1) Szerepel a változónév előtt a `let mut`? 2) Befejeződött-e az előző immutábilis referencia használata, mielőtt mutábilisan használnád?"

msgid "diag_segfault_code"
msgstr "SIGSEGV (139)"

msgid "diag_segfault_explanation"
msgstr "Memóriahozzáférési hiba történt futás közben: a program olyan memóriaterületet próbált olvasni vagy írni, amihez nincs joga (pl. NULL pointer, túlindexelt tömb)."

msgid "diag_segfault_hint"
msgstr "Gyakori okok: 1) Ellenőrizted, hogy a pointer nem NULL? 2) A tömbindex nem lépi át a megengedett határokat (0-tól N-1-ig)? 3) Inicializálatlan mutatóra írsz?"

msgid "diag_undefined_ref_code"
msgstr "Linker Error"

msgid "diag_undefined_ref_explanation"
msgstr "A fordító megtalálta a függvény fejlécét a headerben (.h), de a szerkesztő (linker) nem találja a függvény valódi implementációját (törzsét) a fordított fájlokban."

msgid "diag_undefined_ref_hint"
msgstr "Ellenőrizd: Megadtad az összes .c / .cpp fájlt a fordításkor? (Pl.: `gcc main.c utils.c -o program`)"

msgid "diag_index_error_code"
msgstr "IndexError"

msgid "diag_index_error_explanation"
msgstr "Olyan sorszámú (indexű) elemet kértél le a listából, ami nem létezik (túl nagy az index vagy üres a lista)."

msgid "diag_index_error_hint"
msgstr "Nézd meg a lista hosszát: `len(lista)`. Ne feledd, egy 5 elemű lista indexei: 0, 1, 2, 3, 4."

