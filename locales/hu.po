msgid "Django ORM: Use Model.objects.filter(...) queries. Details in manuals/python/django/ directory."
msgstr "Django ORM: Használd a `Model.objects.filter(...)` lekérdezést. Részletek a `manuals/python/django/` mappában."

msgid "C I/O: printf formats (%d int, %f float, %s string). Scanf needs pointers: scanf(\"%d\", &val). Details in manuals/c/."
msgstr "C I/O: printf formátumok (%d int, %f float, %s string). Scanf-nél mutató kell: `scanf(\"%d\", &val)`. Részletek a `manuals/c/` alatt."

msgid "Rust memory: Either any number of immutable references (&T) or exactly one mutable reference (&mut T) can exist at a time. See manuals/rust/."
msgstr "Rust memória: Egyszerre vagy tetszőleges számú olvasási (&T), vagy pontosan egy írási (&mut T) referencia létezhet. Lásd `manuals/rust/`."

msgid "PHP manual: PDO database connection: new PDO(...). Arrays: associative and indexed. See manuals/php/."
msgstr "PHP kézikönyv: PDO adatbázis-kapcsolat: `new PDO(...)`. Tömbök: asszociatív és indexelt tömbök. Lásd `manuals/php/`."

msgid "Information for [{target}] topic: Search downloaded files in manuals/ directory or refine your query keyword!"
msgstr "Információ a [{target}] témakörhöz: Keresd a letöltött fájlokat a `manuals/` mappában, vagy kérj pontosabb kulcsszót!"

